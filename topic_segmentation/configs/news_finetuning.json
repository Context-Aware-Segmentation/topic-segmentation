{
  "training": {
    "epochs": 10,
    "learning_rate": 2e-05,
    "per_device_batch_size": 4,
    "gradient_accumulation_steps": 2,
    "seed": 42,
    "evaluation_points": 10
  },
  "objectives": {
    "ts": {
      "do_da_ts": false,
      "do_tssp": false,
      "cl_loss_weight": 0.0,
      "tssp_loss_weight": 0.0,
      "cl_temp": 0.5
    },
    "ts_da": {
      "do_da_ts": true,
      "do_tssp": false,
      "cl_loss_weight": 0.0,
      "tssp_loss_weight": 0.0,
      "cl_temp": 0.5
    },
    "cssl": {
      "do_da_ts": false,
      "do_tssp": false,
      "cl_loss_weight": 0.5,
      "tssp_loss_weight": 0.0,
      "cl_temp": 0.1
    },
    "cssl_da": {
      "do_da_ts": true,
      "do_tssp": false,
      "cl_loss_weight": 0.5,
      "tssp_loss_weight": 0.0,
      "cl_temp": 0.1
    },
    "tssp": {
      "do_da_ts": false,
      "do_tssp": true,
      "cl_loss_weight": 0.0,
      "tssp_loss_weight": 1.0,
      "cl_temp": 0.1
    },
    "tssp_da": {
      "do_da_ts": true,
      "do_tssp": true,
      "cl_loss_weight": 0.0,
      "tssp_loss_weight": 1.0,
      "cl_temp": 0.1
    },
    "full_noda": {
      "do_da_ts": false,
      "do_tssp": true,
      "cl_loss_weight": 0.5,
      "tssp_loss_weight": 1.0,
      "cl_temp": 0.1
    },
    "full": {
      "do_da_ts": true,
      "do_tssp": true,
      "cl_loss_weight": 0.5,
      "tssp_loss_weight": 1.0,
      "cl_temp": 0.1
    }
  },
  "backbones": {
    "bert": "checkpoints/bert_base",
    "roberta": "checkpoints/roberta_base",
    "longformer": "checkpoints/longformer_base",
    "modernbert": "checkpoints/modernbert_base",
